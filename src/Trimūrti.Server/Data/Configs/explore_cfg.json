{"ExploreLevelCfg": {"1": {"id": 1, "time": 4, "exp": 2400, "amount": 1, "area": [10001], "meow": [10001], "accumulate_rewards": [[54, 300], [55, 100]]}, "2": {"id": 2, "time": 8, "exp": 20000, "amount": 2, "area": [10001, 10002], "meow": [10001, 10002], "accumulate_rewards": [[54, 600], [55, 300]]}, "3": {"id": 3, "time": 10, "exp": 60000, "amount": 3, "area": [10001, 10002, 10003], "meow": [10001, 10002, 10003], "accumulate_rewards": [[54, 800], [55, 400]]}, "4": {"id": 4, "time": 12, "exp": 150000, "amount": 4, "area": [10001, 10002, 10003, 10004], "meow": [10001, 10002, 10003, 10004], "accumulate_rewards": [[54, 1000], [55, 600]]}, "5": {"id": 5, "time": 20, "exp": 0, "amount": 5, "area": [10001, 10002, 10003, 10004, 10005], "meow": [10001, 10002, 10003, 10004, 10005], "accumulate_rewards": [[54, 1200], [55, 800]]}}, "ExploreAreaCfg": {"10001": {"description": "整个盖亚最为富饶的原质区，自然环境温和宜人。作为光轨的中央传输枢纽与最高理事会的所在地，艾因索菲犹如整个盖亚的脊柱。", "area_name": "艾因索菲", "event_probability": 18, "id": 10001, "icon": "logo_4", "reward": [[53, 50], [54, 60], [56, 8]], "event": [10001, 10002, 10003, 10004, 10005]}, "10002": {"description": "因发达的工业技术与优良的智械产业而闻名的原质区。这里有着整个盖亚最为丰富的电晶石资源，以及风靡各区域的珍酿饮品工坊。", "area_name": "诺伊汉萨", "event_probability": 21, "id": 10002, "icon": "logo_3", "reward": [[53, 50], [55, 12], [56, 12]], "event": [20001, 20002, 20003, 20004, 20005]}, "10003": {"description": "笹波区资源并不丰富，但渔业、农业发展尚可，且林业资源丰富。相对低端的电子器械和特色的手工制品是笹波区的主要出口物。", "area_name": "笹波", "event_probability": 24, "id": 10003, "icon": "logo_2", "reward": [[53, 50], [54, 80], [55, 18]], "event": [30001, 30002, 30003, 30004, 30005]}, "10004": {"description": "别名「艺术之都」的原质区，因为文化艺术的输出而被熟知。全区盛行艺术创作，高造诣者也会拥有更高的社会地位。", "area_name": "欧莫菲斯", "event_probability": 27, "id": 10004, "icon": "logo_5", "reward": [[53, 50], [54, 100]], "event": [40001, 40002, 40003, 40004, 40005]}, "10005": {"description": "盖亚生成的第一个原质区，也是大多数光轨在返回艾因索菲前的中转站。土地中蕴藏着丰富的反重力矿物——云歌石，让这片土地的大部分都漂浮在半空中。", "area_name": "虚恒", "event_probability": 30, "id": 10005, "icon": "logo_1", "reward": [[53, 50], [55, 22]], "event": [50001, 50002, 50003, 50004, 50005]}}, "ExploreMeowCfg": {"10001": {"meow_icon": "3", "inborn": 10001, "skill": 10001, "id": 10001, "meow_name": "弥特尔", "consume": {}, "area_recommend": [10001], "unlock_condition": {}}, "10002": {"meow_icon": "6", "inborn": 10002, "skill": 10002, "id": 10002, "meow_name": "弥芙尔", "consume": [[56, 600]], "area_recommend": [10002], "unlock_condition": [[56, 400]]}, "10003": {"meow_icon": "5", "inborn": 10003, "skill": 10003, "id": 10003, "meow_name": "弥之助", "consume": [[56, 700]], "area_recommend": [10003], "unlock_condition": [[56, 2400]]}, "10004": {"meow_icon": "1", "inborn": 10004, "skill": 10004, "id": 10004, "meow_name": "弥洁儿", "consume": [[56, 800]], "area_recommend": [10004], "unlock_condition": [[56, 6000]]}, "10005": {"meow_icon": "2", "inborn": 10005, "skill": 10005, "id": 10005, "meow_name": "弥可可", "consume": [[56, 900]], "area_recommend": [10005], "unlock_condition": [[56, 16000]]}}, "ExploreMeowSkillCfg": {"10001": {"skill_description": "探索时长超过8h时，探索代币收益增加<color=#F6C800>%s%%</color>", "skill_type": 3, "skill_icon": "1003", "id": 10001, "skill_name": "高速录入", "skill_effect": [5, 10, 15, 20, 25, 30, 35, 40, 45, 50], "skill_up_consume": [[[56, 300]], [[56, 300]], [[56, 400]], [[56, 400]], [[56, 500]], [[56, 500]], [[56, 600]], [[56, 600]], [[56, 700]]]}, "10002": {"skill_description": "探索时长超过8h时，探索代币收益增加<color=#F6C800>%s%%</color>", "skill_type": 3, "skill_icon": "1003", "id": 10002, "skill_name": "劳逸结合", "skill_effect": [5, 10, 15, 20, 25, 30, 35, 40, 45, 50], "skill_up_consume": [[[56, 300]], [[56, 300]], [[56, 400]], [[56, 400]], [[56, 500]], [[56, 500]], [[56, 600]], [[56, 600]], [[56, 700]]]}, "10003": {"skill_description": "探索时长超过8h时，探索代币收益增加<color=#F6C800>%s%%</color>", "skill_type": 3, "skill_icon": "1003", "id": 10003, "skill_name": "忍术精通", "skill_effect": [5, 10, 15, 20, 25, 30, 35, 40, 45, 50], "skill_up_consume": [[[56, 300]], [[56, 300]], [[56, 400]], [[56, 400]], [[56, 500]], [[56, 500]], [[56, 600]], [[56, 600]], [[56, 700]]]}, "10004": {"skill_description": "探索时长超过8h时，探索代币收益增加<color=#F6C800>%s%%</color>", "skill_type": 3, "skill_icon": "1003", "id": 10004, "skill_name": "后勤能手", "skill_effect": [5, 10, 15, 20, 25, 30, 35, 40, 45, 50], "skill_up_consume": [[[56, 300]], [[56, 300]], [[56, 400]], [[56, 400]], [[56, 500]], [[56, 500]], [[56, 600]], [[56, 600]], [[56, 700]]]}, "10005": {"skill_description": "探索时长超过8h时，探索代币收益增加<color=#F6C800>%s%%</color>", "skill_type": 3, "skill_icon": "1003", "id": 10005, "skill_name": "快速烹饪", "skill_effect": [5, 10, 15, 20, 25, 30, 35, 40, 45, 50], "skill_up_consume": [[[56, 300]], [[56, 300]], [[56, 400]], [[56, 400]], [[56, 500]], [[56, 500]], [[56, 600]], [[56, 600]], [[56, 700]]]}}, "ExploreEventCfg": {"10001": {"description": "「爸，我回来了！」\n「……啊，是来买衣服的吗？请进请进……诶？阿时……阿时？！你怎么回来了？」\n「哈？这有什么可惊讶的？学校放假，我就回来了啊……是不是因为店里没什么客人，爸你都不怎么动脑子了呀……」\n「对，对，学校放假嘛……我都糊涂啦，哈哈。」", "effect_description": "探索代币收益增加<color=#F6C800>5%</color>", "event_name": "一家服装店中", "id": 10001, "effect": [1, 5]}, "10002": {"description": "「铁罐侠真是厉害呀~」\n「西海岸队长的战斗力明明更强一些！」\n「要我说嘛，还是吐司侠的综合实力更强一些！」\n「不服吗？不服来战！」", "effect_description": "探索经验收益增加<color=#F6C800>8%</color>", "event_name": "战力之争", "id": 10002, "effect": [2, 8]}, "10003": {"description": "「隔壁老奶奶的猫不是已经……但是我最近又在她家院子里听到猫叫了，莫非是奶奶又养了只新的？」\n「你说这个呀。我最近也见过，看起来好像就是原来那只猫呢。」\n「真是奇怪，我明明记得那猫已经老得动不了了，怎么现在又……算了，老奶奶能开心就是好事。」\n「……不过据我所知，现在那只不是真猫，而是某个技艺高超的工程师做的机械猫哦。」", "effect_description": "探索经验收益增加<color=#F6C800>10%</color>", "event_name": "热心工程师", "id": 10003, "effect": [2, 10]}, "10004": {"description": "「每一次来的时候，公园里都有花开放呢 。」\n「毕竟这座中央公园的亮点就是这个花圃嘛。」\n「我上一次来的时候，还是紫阳花的花期呢，现在已经过啦。」\n「只能等明年啦……」", "effect_description": "探索代币收益增加<color=#F6C800>10%</color>", "event_name": "花期未到", "id": 10004, "effect": [1, 10]}, "10005": {"description": "「说实话，我已经把那位天天长跑的爷爷当时钟看了……虽然说起来有些不礼貌。」\n「比如……再过二十秒，他就会从那个拐角跑出来。」\n「哪位老爷爷？」\n「就是那位……头发很白，胡子很白，牙也很白的那位。」", "effect_description": "探索代币收益增加<color=#F6C800>15%</color>", "event_name": "爱健身的老爷爷", "id": 10005, "effect": [1, 15]}, "20001": {"description": "「……橙汁荣光永存！橙汁荣光永存！橙汁荣光永存！……」\n「那台服务智械是坏掉了吗？怎么像个复读机一样。」\n「听说确实是个坏掉的家伙，不过是那家饮料店的老板特地淘来的。」\n「毕竟这就是家卖橙汁的店……感觉那家伙就跟招财猫似的。」", "effect_description": "探索代币收益增加<color=#F6C800>5%</color>", "event_name": "招财猫？", "id": 20001, "effect": [1, 5]}, "20002": {"description": "「怎么感觉现在的这批保安，跟先前的不太一样？」\n「喂，你可看清楚了，那可不是一般的保安……」", "effect_description": "探索经验收益增加<color=#F6C800>8%</color>", "event_name": "某个工厂门前", "id": 20002, "effect": [2, 8]}, "20003": {"description": "「红桃杰克去哪里了？」\n「不知道。我只记得他之前有天晚上鼻青脸肿地回来，然后就没有然后了。」\n「那个词叫啥来着？金盆洗手？不过在罗斯塔赫这地界，他又能干什么谋生？」", "effect_description": "探索经验收益增加<color=#F6C800>10%</color>", "event_name": "红桃", "id": 20003, "effect": [2, 10]}, "20004": {"description": "「那擂台王以前可不是这样。从前，没有人能打倒他。」\n「可能是年纪大了吧……」\n「不，说不定是上次被那个小伙子打倒之后，自信心受挫啦！」\n「不，不，他并不是这种人。或许他只是放下了什么东西，无所谓输赢了……」", "effect_description": "探索代币收益增加<color=#F6C800>10%</color>", "event_name": "擂台王", "id": 20004, "effect": [1, 10]}, "20005": {"description": "「迷铁之家这帮人怎么老是不见人影？」\n「怎么了？你有什么事要找那帮人么？」\n「倒也没什么，只是上次在珍酿馆碰到了那个鳄鱼头，感觉他人还挺不错的。不过后来就一直没见过了……他们这么忙吗？」", "effect_description": "探索代币收益增加<color=#F6C800>15%</color>", "event_name": "形迹可疑", "id": 20005, "effect": [1, 15]}, "30001": {"description": "「你上次说的那个章鱼烧的摊位，是在哪里来着？」\n「呃，记不清了。不过挺好找的，那个摊主大叔拄拐，有的时候他女儿也会在旁边。」\n「噢噢，那前面这个摊位应该就是了……这章鱼烧真的有那么好吃吗？」\n「我保证这是下京区最好吃的章鱼烧！」", "effect_description": "探索代币收益增加<color=#F6C800>5%</color>", "event_name": "祭典街道", "id": 30001, "effect": [1, 5]}, "30002": {"description": "「很久之前这儿有个名叫『葵』的歌女，她的歌声，真叫人终生难忘啊……」\n「既然这么厉害，她后来为什么没有大红大紫呢？」\n「听说是被选去做宫蛇家的门客了，往后就没什么人再见过她了。」\n「宫蛇家啊……」", "effect_description": "探索经验收益增加<color=#F6C800>8%</color>", "event_name": "音讯", "id": 30002, "effect": [2, 8]}, "30003": {"description": "「这画经年累月，竟已全然看不出原貌了……想来空若当年提笔作画时，还只是个年轻的小子。」\n「不知他的路寻到何处去了，也不知他的画现今作得如何。」\n「尘世中路，到底难寻……」", "effect_description": "探索经验收益增加<color=#F6C800>10%</color>", "event_name": "旧业", "id": 30003, "effect": [2, 10]}, "30004": {"description": "「队长为什么要在这里装一个自动贩卖机？」\n「……可能他觉得饮料供给是必要的吧。」\n「那为什么还要设计成投币式的呢……直接装一台饮料机不就好了？」", "effect_description": "探索代币收益增加<color=#F6C800>10%</color>", "event_name": "饮料自贩机", "id": 30004, "effect": [1, 10]}, "30005": {"description": "「持枪劫持犯？报案人的伴侣被劫持了？」\n「等着，马上到！」\n「正愁没事做呢，快点准备，我们走！」", "effect_description": "探索代币收益增加<color=#F6C800>15%</color>", "event_name": "业绩来咯", "id": 30005, "effect": [1, 15]}, "40001": {"description": "「这已经是这个月第三次了……他们就不能请些正经的马夫来驾车吗？」\n「怎么了？……啊，又是这种事。我还记得上一次的，甚至是卡介伦议员的马车。」\n拉车的马正在悠闲自得地在果蔬店前享用着「自助餐」。\n「我说，要不我们还是在店前面围个栅栏吧？」", "effect_description": "探索代币收益增加<color=#F6C800>5%</color>", "event_name": "「自助餐」", "id": 40001, "effect": [1, 5]}, "40002": {"description": "「不，尘世的笔触并不足以描绘出她的面容……她拥有神赐的完美之躯……」\n「我不明白……我不明白……奥菲利娅，你究竟存在于何处？我要去何处寻你？」\n「请原谅我无法以拙劣的笔触刻画您完美的脸庞……奥菲利娅……」", "effect_description": "探索经验收益增加<color=#F6C800>8%</color>", "event_name": "画家的谵妄", "id": 40002, "effect": [2, 8]}, "40003": {"description": "「从业资格考试的结果出来了！」\n棕色头发的男孩紧闭着双眼，不敢打开终端上的信息。\n「怎么办，要是没通过的话……可是应该能通过……不，万一没有呢……」\n几分钟后，屋子里传出一声兴奋的大喊。", "effect_description": "探索经验收益增加<color=#F6C800>10%</color>", "event_name": "恭喜你！", "id": 40003, "effect": [2, 10]}, "40004": {"description": "「信息搜索中……搜索完毕。准入名单中无对应结果。」\n「非准入人员……判断为入侵者。」", "effect_description": "探索代币收益增加<color=#F6C800>10%</color>", "event_name": "奇怪的雕像", "id": 40004, "effect": [1, 10]}, "40005": {"description": "「地爆烟花？你要去看那种东西？我只记得这东西出过事故，你可要想清楚！」\n「啊？您完全不看新作月赏的吗？明明最近的演出都很成功啊！」\n「不行，不能去，我说的！」\n「可是真的很壮观诶……您看……」", "effect_description": "探索代币收益增加<color=#F6C800>15%</color>", "event_name": "劝说", "id": 40005, "effect": [1, 15]}, "50001": {"description": "「呜呼呼——围城之外，可退敌乎？」\n「魑魅尽除，可缓缓归矣！」\n「恭喜你~这个『呜呼呼·呼啦圈』是你的啦！」\n「好耶！」", "effect_description": "探索代币收益增加<color=#F6C800>5%</color>", "event_name": "漫画签售会", "id": 50001, "effect": [1, 5]}, "50002": {"description": "「云翁先生，您这店里先前那幅《洛川上河图》怎么不见了？」\n「前些日子已经售出了。」\n「我就说嘛，您的画作，定会有人赏识的！」\n「嗯……也许算是吧。」", "effect_description": "探索经验收益增加<color=#F6C800>8%</color>", "event_name": "书画店", "id": 50002, "effect": [2, 8]}, "50003": {"description": "「刚才那位客人，是不是在问咱家的麻婆豆腐有没有改过配方？」\n「是啊……诶对，我刚才就觉得眼熟，那不是庚辰先生吗！」\n「莫非是咱们今天的火候没掌握好，或者调料放少了，或者是别的什么原因……」\n「不过我觉得，如果庚辰先生对口味有所不满，应该会直接对咱们说吧？别多操心啦。」", "effect_description": "探索经验收益增加<color=#F6C800>10%</color>", "event_name": "麻婆豆腐的口味", "id": 50003, "effect": [2, 10]}, "50004": {"description": "「怎么有这么大的狗叫声？」\n「好像是有几条狗在追着人跑。」\n「欸不对，你看那被追着的人……」\n「……这不是孟章代理吗！发生什么事了！」", "effect_description": "探索代币收益增加<color=#F6C800>10%</color>", "event_name": "热心市民", "id": 50004, "effect": [1, 10]}, "50005": {"description": "「你按着这个药方去抓药，然后服药的频次写在这张纸上。」\n「多谢了……没想到你这么精通医术，上次的病，也多亏了你……」\n「没什么，只是久病成医……每次去赤炁堂的时候，陵光代理有空就会亲自教予我医病的逻辑和方法……渐渐地，我也略懂一二啦。」", "effect_description": "探索代币收益增加<color=#F6C800>15%</color>", "event_name": "为万民式", "id": 50005, "effect": [1, 15]}}, "ExploreMeowInbornCfg": {"10001": {"inborn_icon": "2001", "inborn_name": "数据共享", "id": 10001, "inborn_description": "探索艾因索菲时，探索收益增加<color=#F6C800>30%</color>", "inborn_effect": [10001, 30]}, "10002": {"inborn_icon": "2002", "inborn_name": "数据共享", "id": 10002, "inborn_description": "探索诺伊汉萨时，探索收益增加<color=#F6C800>30%</color>", "inborn_effect": [10002, 30]}, "10003": {"inborn_icon": "2003", "inborn_name": "数据共享", "id": 10003, "inborn_description": "探索笹波时，探索收益增加<color=#F6C800>30%</color>", "inborn_effect": [10003, 30]}, "10004": {"inborn_icon": "2004", "inborn_name": "数据共享", "id": 10004, "inborn_description": "探索欧莫菲斯时，探索收益增加<color=#F6C800>30%</color>", "inborn_effect": [10004, 30]}, "10005": {"inborn_icon": "2005", "inborn_name": "数据共享", "id": 10005, "inborn_description": "探索虚恒时，探索收益增加<color=#F6C800>30%</color>", "inborn_effect": [10005, 30]}}, "log": {"events": {"101": {"event_type": 1, "reward": ""}, "102": {"event_type": 1, "reward": ""}, "103": {"event_type": 1, "reward": ""}, "104": {"event_type": 1, "reward": ""}, "105": {"event_type": 1, "reward": ""}, "106": {"event_type": 1, "reward": ""}, "107": {"event_type": 1, "reward": ""}, "108": {"event_type": 1, "reward": ""}, "109": {"event_type": 1, "reward": ""}, "110": {"event_type": 1, "reward